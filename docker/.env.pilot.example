# Public Messenger origin, as seen by the browser. No trailing slash.
PILOT_ORIGIN=https://messenger.example.invalid
PILOT_HTTP_PORT=8080

# Server-to-server URLs accessible to the Linux containers.
SRV_IAM_BASE_URL=https://desk-api.example.invalid
# Optional. If empty, defaults to SRV_IAM_BASE_URL.
DIODESK_BASE_URL=

# Generate a different random value for every field. Use URL-safe characters.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBIT_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Use the deployed commit SHA. This also tags the locally built images.
MESSENGER_RELEASE=local

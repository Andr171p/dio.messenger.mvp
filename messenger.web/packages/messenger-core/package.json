{
  "name": "@dio/messenger-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript ../../docs/contracts/openapi-messenger.json -o src/transport/generated/messenger-api.d.ts"
  },
  "dependencies": {
    "dexie": "^4.0.10"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "openapi-typescript": "^7.4.4",
    "vitest": "^2.1.8"
  }
}